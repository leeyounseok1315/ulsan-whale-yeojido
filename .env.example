# 관광 OpenAPI(공공데이터) 비밀값 — 서버(BFF)에서만 사용. 클라이언트 노출 금지.
# 실제 값은 .env.local 에 두고 절대 커밋하지 않는다.
TOUR_API_SERVICE_KEY=

# 관광 OpenAPI 베이스 URL (국문관광정보 서비스, *2 시리즈)
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# 울산 area code (고정)
TOUR_API_AREA_CODE=7

# 일일 호출 한도(쿼터 모니터링 기준). 초과 임박 시 경고, 초과 시 호출 차단 후 캐시 폴백.
TOUR_API_DAILY_QUOTA=1000

# mock 모드: serviceKey 미발급 시 mock 픽스처로 동작 (W1~W2). 키 발급 후 false 로.
USE_MOCK_DATA=true

# 캐시 — Upstash Redis(REST). 둘 다 비우면 인메모리로 자동 폴백(개발용).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 배치 수집·캐시 퍼지 엔드포인트(/api/batch/collect, /api/admin/purge) 보호 토큰.
# ⚠️ 미설정이면 두 엔드포인트는 401로 '거부'된다(fail-closed) — 비워두면 Cron이 동작하지 않는다.
# 배포 전 반드시 랜덤 값으로 설정: openssl rand -hex 32
# (Vercel Cron은 이 값으로 Authorization 헤더를 자동 첨부 — vercel.json crons 참고)
CRON_SECRET=

# (로컬 개발 전용) CRON_SECRET 없이 배치/퍼지를 호출하고 싶을 때만 명시적으로 켠다.
# 프로덕션(NODE_ENV=production)에서는 무시된다.
ALLOW_INSECURE_CRON=false

# (선택) 배치 실패 알림 웹훅(슬랙 등). 미설정 시 서버 로그로만.
ALERT_WEBHOOK_URL=

# 수집 스크립트(npm run collect)가 호출할 베이스 URL (로컬 기본값 사용 시 생략 가능)
BASE_URL=http://localhost:3000

# 대중교통(버스) 경로 OpenAPI 키 — 서버 전용. /api/transit 에서만 사용한다.
# ⚠️ NEXT_PUBLIC_ 접두사를 붙이면 클라이언트 번들에 그대로 실린다. 절대 금지.
# 미설정이면 대중교통 안내만 조용히 꺼지고 나머지 기능은 정상 동작한다.
ODSAY_API_KEY=

# 대중교통 API 일일 호출 상한. 무료 한도가 30회/일이고 초과분은 과금되므로
# 기본값을 한도와 같게 둔다. 결과는 Redis에 7일 공유 캐시되어 실제 외부 호출은
# 스팟 조합이 한 번 데워진 뒤로 거의 발생하지 않는다.
# 상한을 넘기면 호출하지 않고 택시 예상요금으로 대체한다(fail-closed).
ODSAY_DAILY_LIMIT=30
