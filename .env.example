# 관광 OpenAPI(공공데이터) 비밀값 — 서버(BFF)에서만 사용. 클라이언트 노출 금지.
# 실제 값은 .env.local 에 두고 절대 커밋하지 않는다.
TOUR_API_SERVICE_KEY=

# 관광 OpenAPI 베이스 URL (국문관광정보 서비스, *2 시리즈)
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# 울산 area code (고정)
TOUR_API_AREA_CODE=7

# Redis(캐시) — Phase: Upstash 등. MVP 초기엔 비워둬도 동작.
REDIS_URL=

# mock 모드: serviceKey 미발급 시 mock 픽스처로 동작 (W1~W2)
USE_MOCK_DATA=true
