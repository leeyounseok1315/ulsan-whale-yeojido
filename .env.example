# 관광 OpenAPI(공공데이터) 비밀값 — 서버(BFF)에서만 사용. 클라이언트 노출 금지.
# 실제 값은 .env.local 에 두고 절대 커밋하지 않는다.
TOUR_API_SERVICE_KEY=

# 관광 OpenAPI 베이스 URL (국문관광정보 서비스, *2 시리즈)
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# 울산 area code (고정)
TOUR_API_AREA_CODE=7

# 일일 호출 한도(쿼터 모니터링 기준). 초과 임박 시 경고, 초과 시 호출 차단 후 캐시 폴백.
TOUR_API_DAILY_QUOTA=1000

# mock 모드: serviceKey 미발급 시 mock 픽스처로 동작 (W1~W2). 키 발급 후 false 로.
USE_MOCK_DATA=true

# 캐시 — Upstash Redis(REST). 둘 다 비우면 인메모리로 자동 폴백(개발용).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 배치 수집 엔드포인트(/api/batch/collect) 보호 토큰. 배포 시 반드시 설정.
CRON_SECRET=

# 수집 스크립트(npm run collect)가 호출할 베이스 URL (로컬 기본값 사용 시 생략 가능)
BASE_URL=http://localhost:3000
